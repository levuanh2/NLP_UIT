# ==================================================
# APPLICATION
# ==================================================
APP_NAME=legal-rag
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# ==================================================
# PATHS
# ==================================================
PROJECT_ROOT=.
DATA_DIR=./data
CORPUS_DATA_DIR=./data/corpus
QUESTION_DATA_DIR=./data/questions
OUTPUT_DIR=./data/outputs
CACHE_DATA_DIR=./data/cache
MODEL_DIR=./models
FAISS_DIR=./storage/faiss
BM25_DIR=./storage/bm25
SQLITE_DIR=./storage/sqlite
SQLITE_DATABASE_PATH=./storage/sqlite/legal.db
INDEX_ROOT_DIR=./storage/indexes
CHECKPOINT_DIR=./storage/checkpoints

# ==================================================
# CONFIGURATION
# ==================================================
CONFIG_DIR=./configs
BASE_CONFIG_PATH=./configs/base.yaml
MODELS_CONFIG_PATH=./configs/models.yaml
CHUNKING_CONFIG_PATH=./configs/chunking.yaml
RETRIEVAL_CONFIG_PATH=./configs/retrieval.yaml
GENERATION_CONFIG_PATH=./configs/generation.yaml
EVALUATION_CONFIG_PATH=./configs/evaluation.yaml

# ==================================================
# MODELS
# ==================================================
LLM_MODEL_NAME=AITeamVN/Vi-Qwen2-3B-RAG
EMBEDDING_MODEL_NAME=bqbbao6/vietnamese-legal-embedding
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker
MODEL_LOCAL_FILES_ONLY=true
MODEL_TRUST_REMOTE_CODE=false

# ==================================================
# MODEL DEVICE
# ==================================================
MODEL_DEVICE=auto
MODEL_DTYPE=auto
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# ==================================================
# CHUNKING
# ==================================================
PARENT_TARGET_TOKENS=1024
PARENT_MAX_TOKENS=2048
CHILD_TARGET_TOKENS=256
CHILD_MAX_TOKENS=384

# ==================================================
# RETRIEVAL
# ==================================================
METADATA_FILTER_ENABLED=true
METADATA_FILTER_MIN_CONFIDENCE=0.80
METADATA_FILTER_FALLBACK_TO_FULL_CORPUS=true
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_TOP_K=30
RERANKER_ENABLED=true
RERANKER_TOP_K=5
RRF_K=60
RETRIEVAL_TRACE=false

# ==================================================
# STREAMING INGESTION / INDEX
# ==================================================
CORPUS_DIR=./data/corpus
INGESTION_RESUME=true
INGESTION_CHUNK_BATCH_SIZE=1000
INGESTION_EMBEDDING_BATCH_SIZE=64
INGESTION_CHECKSUM_ALGORITHM=sha256
CHUNKING_VERSION=v2
INGESTION_CONTINUE_ON_DOCUMENT_ERROR=true
MAX_DOCUMENT_WORDS_WARNING=100000
SQLITE_BATCH_SIZE=1000
FAISS_INDEX_TYPE=auto
FAISS_NORMALIZE=true
INDEX_ATOMIC_PUBLISH=true
CONTEXT_NEIGHBOR_WINDOW=1
MAX_PARENTS_PER_DOCUMENT=3
CONTEXT_MAX_TOKENS=6000

# ==================================================
# GENERATION
# ==================================================
LLM_MAX_NEW_TOKENS=192
LLM_MIN_NEW_TOKENS=0
LLM_REPETITION_PENALTY=1.1
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_DO_SAMPLE=false
LLM_MAX_CONTEXT_TOKENS=4096
LLM_CITATION_REPAIR_ENABLED=true
LLM_CITATION_REPAIR_MAX_RETRIES=1
GENERATION_TRACE=false
REQUIRE_CITATION=true
GROUNDED_ONLY=true
ABSTAIN_WHEN_INSUFFICIENT=true

# ==================================================
# SUBMISSION
# ==================================================
SUBMISSION_FILENAME=submission.json
SUBMISSION_ENCODING=utf-8
SUBMISSION_ENSURE_ASCII=false
