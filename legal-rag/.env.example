# ==================================================
# APPLICATION
# ==================================================
APP_NAME=legal-rag
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# ==================================================
# PATHS
# ==================================================
PROJECT_ROOT=.
DATA_DIR=./data
CORPUS_DATA_DIR=./data/corpus
QUESTION_DATA_DIR=./data/questions
OUTPUT_DIR=./data/outputs
CACHE_DATA_DIR=./data/cache
MODEL_DIR=./models
FAISS_DIR=./storage/faiss
BM25_DIR=./storage/bm25
SQLITE_DIR=./storage/sqlite
SQLITE_DATABASE_PATH=./storage/sqlite/legal.db

# ==================================================
# CONFIGURATION
# ==================================================
CONFIG_DIR=./configs
BASE_CONFIG_PATH=./configs/base.yaml
MODELS_CONFIG_PATH=./configs/models.yaml
CHUNKING_CONFIG_PATH=./configs/chunking.yaml
RETRIEVAL_CONFIG_PATH=./configs/retrieval.yaml
GENERATION_CONFIG_PATH=./configs/generation.yaml
EVALUATION_CONFIG_PATH=./configs/evaluation.yaml

# ==================================================
# MODELS
# ==================================================
LLM_MODEL_NAME=AITeamVN/Vi-Qwen2-1.5B-RAG
EMBEDDING_MODEL_NAME=bqbbao6/vietnamese-legal-embedding
RERANKER_MODEL_NAME=AITeamVN/Vietnamese_Reranker
MODEL_LOCAL_FILES_ONLY=true
MODEL_TRUST_REMOTE_CODE=false

# ==================================================
# MODEL DEVICE
# ==================================================
MODEL_DEVICE=auto
MODEL_DTYPE=auto
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# ==================================================
# CHUNKING
# ==================================================
PARENT_TARGET_TOKENS=1024
PARENT_MAX_TOKENS=2048
CHILD_TARGET_TOKENS=256
CHILD_MAX_TOKENS=384

# ==================================================
# RETRIEVAL
# ==================================================
METADATA_FILTER_ENABLED=true
METADATA_FILTER_MIN_CONFIDENCE=0.80
METADATA_FILTER_FALLBACK_TO_FULL_CORPUS=true
DENSE_TOP_N=20
BM25_TOP_N=20
FUSION_TOP_N=30
RERANK_ENABLED=true
RERANK_TOP_K=5
RRF_K=60

# ==================================================
# GENERATION
# ==================================================
MAX_NEW_TOKENS=512
TEMPERATURE=0.1
TOP_P=0.9
DO_SAMPLE=false
REQUIRE_CITATION=true
GROUNDED_ONLY=true
ABSTAIN_WHEN_INSUFFICIENT=true

# ==================================================
# SUBMISSION
# ==================================================
SUBMISSION_FILENAME=submission.json
SUBMISSION_ENCODING=utf-8
SUBMISSION_ENSURE_ASCII=false
