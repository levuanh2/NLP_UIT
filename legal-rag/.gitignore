.env

# ==========================
# Competition Dataset
# ==========================

data/corpus/*
!data/corpus/.gitkeep

data/questions/*
!data/questions/.gitkeep

data/outputs/*
!data/outputs/.gitkeep

data/cache/*
!data/cache/.gitkeep

# Generated grounding evaluation contains model answers and full evidence blocks.
data/evaluation/grounding_50/

# ==========================
# Local databases
# ==========================

storage/faiss/*
!storage/faiss/.gitkeep

storage/bm25/*
!storage/bm25/.gitkeep

storage/sqlite/*
!storage/sqlite/.gitkeep

storage/indexes/*
!storage/indexes/.gitkeep

storage/checkpoints/*
!storage/checkpoints/.gitkeep

*.db
*.sqlite
*.sqlite3
# Transient SQLite journal state, not source.
*.sqlite-wal
*.sqlite-shm

# FAISS shards are derived data rebuilt by `legal-rag ingest`, ~167 MB each,
# which is over GitHub's 100 MB per-file hard limit.
storage/**/faiss/*.index
storage/**/faiss/*.index.ids.json
storage/**/faiss/shards.json

# ==========================
# Downloaded Models
# ==========================

models/*
!models/.gitkeep

# ==========================
# Python
# ==========================

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================
# Virtual Environment
# ==========================

.venv/
venv/
env/

# ==========================
# IDE
# ==========================

.vscode/
.idea/
